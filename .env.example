# Shared with the whole team (pin it in the group chat). Members enter it once, then pick their name.
TEAM_CODE=
# Only for leaders and coordinators. Unlocks the lineup builder on the Me page.
LEADER_CODE=
# Long random string used to sign sessions. Generate one with: openssl rand -base64 32
SESSION_SECRET=
# Postgres connection string for production (for example Neon from the Vercel Marketplace).
# Leave empty locally to use the built-in database in .data/pglite.
DATABASE_URL=
# Time zone used to decide what "today" is. Defaults to Asia/Manila.
APP_TIMEZONE=Asia/Manila

# Web Push: npm run notifications:setup generates a stable pair in .env.local.
# Copy all four values privately into Vercel. Keep the private key and cron secret secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=https://github.com/MarklorenceB/gplc-worship
CRON_SECRET=
# Only used by the optional notification worker. Set the production HTTPS URL remotely.
APP_URL=http://localhost:3004
